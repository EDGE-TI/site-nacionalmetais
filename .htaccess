Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

<IfModule mod_expires.c>
    # Ativa o módulo de expiração
    ExpiresActive On

    # Imagens e Ícones (Guardar por 1 ano)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS e JavaScript (Guardar por 1 mês a 1 ano)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fontes (Guardar por 1 ano)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Documentos HTML (NÃO GUARDAR - Para atualizar sempre que você mudar o texto)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Adiciona os cabeçalhos 'Cache-Control' modernos
    <FilesMatch "\.(ico|jpe?g|png|gif|swf|svg|webp|woff2?|ttf|css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Define qual é a página de erro oficial do site
ErrorDocument 404 /404.html

# 1. REDIRECIONAMENTO EXTERNO
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/post\.html\?slug=([^\s&]+) [NC]
RewriteRule ^ /blog/%1? [R=301,L]

# 2. EXCEÇÃO: Se o arquivo real existir, abre
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. PÁGINAS FIXAS (ex: /contato)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [NC,L]

# 4. REESCRITA DO BLOG: Agora ele exige a palavra "blog/" antes do slug
RewriteRule ^blog/([a-zA-Z0-9_-]+)$ post.html?slug=$1 [QSA,L]